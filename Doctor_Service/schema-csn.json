          "type": "cds.Decimal",
          "precision": 4,
          "scale": 1
        },
        "Qualification": {
          "type": "cds.String",
          "length": 100
        },
        "Registration_Number": {
          "type": "cds.String",
          "length": 50
        },
        "Doctor_Specializations": {
          "type": "cds.Composition",
          "cardinality": {
            "max": "*"
          },
          "target": "hospital.DoctorSpecializations",
          "on": [
            {
              "ref": [
                "Doctor_Specializations",
                "Doctor"
              ]
            },
            "=",
            {
              "ref": [
                "$self"
              ]
            }
          ]
        },
        "Doctor_Schedule": {
