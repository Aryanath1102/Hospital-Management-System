        "Last_Name": {
          "type": "cds.String",
          "length": 20
        },
        "Full_Name": {
          "@Core.Computed": true,
          "type": "cds.String",
          "length": 100,
          "value": {
            "stored": true,
            "xpr": [
              {
                "val": "Dr. "
              },
              "||",
              {
                "ref": [
                  "First_Name"
                ]
              },
              "||",
              {
                "val": " "
              },
              "||",
              {
                "ref": [
                  "Last_Name"
                ]
              }
            ]
          }
        },
        "Gender": {
          "type": "hospital.Gender"
        },
        "Department": {
          "type": "cds.Association",
          "target": "hospital.Departments",
