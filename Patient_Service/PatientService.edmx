<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="4.0" xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx">
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
    <edmx:Include Alias="Common" Namespace="com.sap.vocabularies.Common.v1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Core.V1.xml">
    <edmx:Include Alias="Core" Namespace="Org.OData.Core.V1"/>
  </edmx:Reference>
  <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
    <edmx:Include Alias="UI" Namespace="com.sap.vocabularies.UI.v1"/>
  </edmx:Reference>
  <edmx:DataServices>
    <Schema Namespace="PatientService" xmlns="http://docs.oasis-open.org/odata/ns/edm">
      <Annotation Term="Core.Links">
        <Collection>
          <Record>
            <PropertyValue Property="rel" String="author"/>
            <PropertyValue Property="href" String="https://cap.cloud.sap"/>
          </Record>
        </Collection>
      </Annotation>
      <EntityContainer Name="EntityContainer">
        <EntitySet Name="Genders" EntityType="PatientService.Genders"/>
        <EntitySet Name="PatientStatus" EntityType="PatientService.PatientStatus"/>
        <EntitySet Name="Patients" EntityType="PatientService.Patients">
          <NavigationPropertyBinding Path="genderMaster" Target="Genders"/>
          <NavigationPropertyBinding Path="statusMaster" Target="PatientStatus"/>
          <NavigationPropertyBinding Path="SiblingEntity" Target="Patients"/>
        </EntitySet>
        <FunctionImport Name="getPatientNo" Function="PatientService.getPatientNo"/>
      </EntityContainer>
      <EntityType Name="Genders">
        <Key>
          <PropertyRef Name="code"/>
        </Key>
        <Property Name="code" Type="Edm.String" MaxLength="100" Nullable="false"/>
        <Property Name="name" Type="Edm.String" MaxLength="100"/>
      </EntityType>
      <EntityType Name="PatientStatus">
        <Key>
          <PropertyRef Name="code"/>
        </Key>
        <Property Name="code" Type="Edm.Boolean" Nullable="false"/>
        <Property Name="text" Type="Edm.String" MaxLength="20"/>
      </EntityType>
      <EntityType Name="Patients">
        <Key>
          <PropertyRef Name="ID"/>
          <PropertyRef Name="IsActiveEntity"/>
        </Key>
        <Property Name="createdAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="createdBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="modifiedAt" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="modifiedBy" Type="Edm.String" MaxLength="255"/>
        <Property Name="ID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="patientNo" Type="Edm.String" MaxLength="10"/>
        <Property Name="firstName" Type="Edm.String" MaxLength="50"/>
        <Property Name="lastName" Type="Edm.String" MaxLength="50"/>
        <Property Name="gender" Type="Edm.String" MaxLength="10"/>
        <NavigationProperty Name="genderMaster" Type="PatientService.Genders">
          <ReferentialConstraint Property="gender" ReferencedProperty="code"/>
        </NavigationProperty>
        <Property Name="genderRemark" Type="Edm.String" MaxLength="50"/>
        <Property Name="hideGenderRemark" Type="Edm.Boolean"/>
        <Property Name="age" Type="Edm.Int32"/>
        <Property Name="bloodGroup" Type="Edm.String" MaxLength="5"/>
        <Property Name="phone" Type="Edm.String" MaxLength="15"/>
        <Property Name="email" Type="Edm.String" MaxLength="100"/>
        <Property Name="address" Type="Edm.String" MaxLength="200"/>
        <Property Name="city" Type="Edm.String" MaxLength="50"/>
        <Property Name="state" Type="Edm.String" MaxLength="50"/>
        <Property Name="country" Type="Edm.String" MaxLength="50"/>
        <Property Name="pincode" Type="Edm.String" MaxLength="10"/>
        <Property Name="emergencyName" Type="Edm.String" MaxLength="50"/>
        <Property Name="emergencyPhone" Type="Edm.String" MaxLength="15"/>
        <Property Name="isActive" Type="Edm.Boolean" DefaultValue="true"/>
        <NavigationProperty Name="statusMaster" Type="PatientService.PatientStatus">
          <ReferentialConstraint Property="isActive" ReferencedProperty="code"/>
        </NavigationProperty>
        <Property Name="statusCriticality" Type="Edm.Int32"/>
        <Property Name="IsActiveEntity" Type="Edm.Boolean" Nullable="false" DefaultValue="true"/>
        <Property Name="HasActiveEntity" Type="Edm.Boolean" Nullable="false" DefaultValue="false"/>
        <Property Name="HasDraftEntity" Type="Edm.Boolean" Nullable="false" DefaultValue="false"/>
        <NavigationProperty Name="DraftAdministrativeData" Type="PatientService.DraftAdministrativeData" ContainsTarget="true"/>
        <NavigationProperty Name="SiblingEntity" Type="PatientService.Patients"/>
        <Property Name="DraftMessages" Type="Collection(PatientService.DRAFT_DraftAdministrativeData_DraftMessage)" Nullable="true"/>
      </EntityType>
      <EntityType Name="DraftAdministrativeData">
        <Key>
          <PropertyRef Name="DraftUUID"/>
        </Key>
        <Property Name="DraftUUID" Type="Edm.Guid" Nullable="false"/>
        <Property Name="CreationDateTime" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="CreatedByUser" Type="Edm.String" MaxLength="256"/>
        <Property Name="DraftIsCreatedByMe" Type="Edm.Boolean"/>
        <Property Name="LastChangeDateTime" Type="Edm.DateTimeOffset" Precision="7"/>
        <Property Name="LastChangedByUser" Type="Edm.String" MaxLength="256"/>
        <Property Name="InProcessByUser" Type="Edm.String" MaxLength="256"/>
        <Property Name="DraftIsProcessedByMe" Type="Edm.Boolean"/>
      </EntityType>
      <ComplexType Name="DRAFT_DraftAdministrativeData_DraftMessage">
        <Property Name="code" Type="Edm.String"/>
        <Property Name="message" Type="Edm.String"/>
        <Property Name="target" Type="Edm.String"/>
        <Property Name="additionalTargets" Type="Collection(Edm.String)" Nullable="true"/>
        <Property Name="transition" Type="Edm.Boolean"/>
        <Property Name="numericSeverity" Type="Edm.Byte"/>
        <Property Name="longtextUrl" Type="Edm.String"/>
      </ComplexType>
      <Action Name="DeactivatePatient" IsBound="true">
        <Parameter Name="in" Type="PatientService.Patients"/>
      </Action>
      <Action Name="ActivatePatient" IsBound="true">
        <Parameter Name="in" Type="PatientService.Patients"/>
      </Action>
      <Action Name="draftPrepare" IsBound="true" EntitySetPath="in">
        <Parameter Name="in" Type="PatientService.Patients"/>
        <Parameter Name="SideEffectsQualifier" Type="Edm.String"/>
        <ReturnType Type="PatientService.Patients"/>
      </Action>
      <Action Name="draftActivate" IsBound="true" EntitySetPath="in">
        <Parameter Name="in" Type="PatientService.Patients"/>
        <ReturnType Type="PatientService.Patients"/>
      </Action>
      <Action Name="draftEdit" IsBound="true" EntitySetPath="in">
        <Parameter Name="in" Type="PatientService.Patients"/>
        <Parameter Name="PreserveChanges" Type="Edm.Boolean"/>
        <ReturnType Type="PatientService.Patients"/>
      </Action>
      <Function Name="getPatientNo" IsBound="false" IsComposable="false">
        <ReturnType Type="Edm.String"/>
      </Function>
      <Annotations Target="PatientService.EntityContainer">
        <Annotation Term="Core.Description" String="REST API for Hospital Management System. Features: Patients, Genders, Patient Status, Patient Actions, Patient Draft Management."/>
        <Annotation Term="Common.AddressViaNavigationPath" Bool="true"/>
        <Annotation Term="Common.Label" String="Hospital Patient Management API"/>
      </Annotations>
      <Annotations Target="PatientService.Patients">
        <Annotation Term="UI.HeaderInfo">
          <Record Type="UI.HeaderInfoType">
            <PropertyValue Property="TypeName" String="Patient"/>
            <PropertyValue Property="TypeNamePlural" String="Patients"/>
            <PropertyValue Property="Title">
              <Record Type="UI.DataField">
                <PropertyValue Property="Value" Path="firstName"/>
              </Record>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.SelectionFields">
          <Collection>
            <PropertyPath>patientNo</PropertyPath>
            <PropertyPath>firstName</PropertyPath>
            <PropertyPath>phone</PropertyPath>
            <PropertyPath>bloodGroup</PropertyPath>
            <PropertyPath>isActive</PropertyPath>
          </Collection>
        </Annotation>
        <Annotation Term="UI.LineItem">
          <Collection>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="patientNo"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="firstName"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="lastName"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="gender"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="age"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="phone"/>
            </Record>
            <Record Type="UI.DataField">
              <PropertyValue Property="Value" Path="isActive"/>
              <PropertyValue Property="Criticality" Path="statusCriticality"/>
            </Record>
          </Collection>
        </Annotation>
        <Annotation Term="UI.Facets">
          <Collection>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="Label" String="General Information"/>
              <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#General"/>
            </Record>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="Label" String="Contact Information"/>
              <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Contact"/>
            </Record>
            <Record Type="UI.ReferenceFacet">
              <PropertyValue Property="Label" String="Emergency Contact"/>
              <PropertyValue Property="Target" AnnotationPath="@UI.FieldGroup#Emergency"/>
            </Record>
          </Collection>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="General">
          <Record Type="UI.FieldGroupType">
            <PropertyValue Property="Data">
              <Collection>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="firstName"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="lastName"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="gender"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="genderRemark"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="age"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="bloodGroup"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="isActive"/>
                  <PropertyValue Property="Criticality" Path="statusCriticality"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="Contact">
          <Record Type="UI.FieldGroupType">
            <PropertyValue Property="Data">
              <Collection>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="phone"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="email"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="address"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="city"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="state"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="country"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="pincode"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.FieldGroup" Qualifier="Emergency">
          <Record Type="UI.FieldGroupType">
            <PropertyValue Property="Data">
              <Collection>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="emergencyName"/>
                </Record>
                <Record Type="UI.DataField">
                  <PropertyValue Property="Value" Path="emergencyPhone"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="UI.Identification">
          <Collection>
            <Record Type="UI.DataFieldForAction">
              <PropertyValue Property="Action" String="PatientService.DeactivatePatient"/>
              <PropertyValue Property="Label" String="Deactivate Patient"/>
            </Record>
            <Record Type="UI.DataFieldForAction">
              <PropertyValue Property="Action" String="PatientService.ActivatePatient"/>
              <PropertyValue Property="Label" String="Activate Patient"/>
            </Record>
          </Collection>
        </Annotation>
        <Annotation Term="Common.SideEffects" Qualifier="alwaysFetchMessages">
          <Record Type="Common.SideEffectsType">
            <PropertyValue Property="SourceEntities">
              <Collection>
                <NavigationPropertyPath></NavigationPropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="TargetProperties">
              <Collection>
                <String>DraftMessages</String>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
        <Annotation Term="Common.Messages" Path="DraftMessages"/>
      </Annotations>
      <Annotations Target="PatientService.EntityContainer/Patients">
        <Annotation Term="Common.DraftRoot">
          <Record Type="Common.DraftRootType">
            <PropertyValue Property="ActivationAction" String="PatientService.draftActivate"/>
            <PropertyValue Property="EditAction" String="PatientService.draftEdit"/>
            <PropertyValue Property="PreparationAction" String="PatientService.draftPrepare"/>
          </Record>
        </Annotation>
        <Annotation Term="Common.SideEffects" Qualifier="alwaysFetchMessages">
          <Record Type="Common.SideEffectsType">
            <PropertyValue Property="SourceEntities">
              <Collection>
                <NavigationPropertyPath></NavigationPropertyPath>
              </Collection>
            </PropertyValue>
            <PropertyValue Property="TargetProperties">
              <Collection>
                <String>DraftMessages</String>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="PatientService.Patients/createdAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedAt}"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/createdBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Immutable" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>CreatedBy}"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/modifiedAt">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedAt}"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/modifiedBy">
        <Annotation Term="UI.HiddenFilter" Bool="true"/>
        <Annotation Term="UI.ExcludeFromNavigationContext" Bool="true"/>
        <Annotation Term="Core.Computed" Bool="true"/>
        <Annotation Term="Core.Description" String="{i18n>UserID.Description}"/>
        <Annotation Term="Common.Label" String="{i18n>ChangedBy}"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/ID">
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/patientNo">
        <Annotation Term="Common.Label" String="Patient Number"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/firstName">
        <Annotation Term="Common.Label" String="First Name"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/lastName">
        <Annotation Term="Common.Label" String="Last Name"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/gender">
        <Annotation Term="Common.Label" String="Gender"/>
        <Annotation Term="Common.ValueListWithFixedValues" Bool="true"/>
        <Annotation Term="Common.ValueList">
          <Record Type="Common.ValueListType">
            <PropertyValue Property="CollectionPath" String="Genders"/>
            <PropertyValue Property="Parameters">
              <Collection>
                <Record Type="Common.ValueListParameterInOut">
                  <PropertyValue Property="LocalDataProperty" PropertyPath="gender"/>
                  <PropertyValue Property="ValueListProperty" String="code"/>
                </Record>
              </Collection>
            </PropertyValue>
          </Record>
        </Annotation>
      </Annotations>
      <Annotations Target="PatientService.Patients/genderRemark">
        <Annotation Term="Common.Label" String="Gender Remark"/>
        <Annotation Term="UI.Hidden">
          <Eq>
            <Path>hideGenderRemark</Path>
            <Bool>true</Bool>
          </Eq>
        </Annotation>
      </Annotations>
      <Annotations Target="PatientService.Patients/hideGenderRemark">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/age">
        <Annotation Term="Common.Label" String="Age"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/bloodGroup">
        <Annotation Term="Common.Label" String="Blood Group"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/phone">
        <Annotation Term="Common.Label" String="Phone"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/email">
        <Annotation Term="Common.Label" String="Email"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/address">
        <Annotation Term="Common.Label" String="Address"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/city">
        <Annotation Term="Common.Label" String="City"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/state">
        <Annotation Term="Common.Label" String="State"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/country">
        <Annotation Term="Common.Label" String="Country"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/pincode">
        <Annotation Term="Common.Label" String="Pincode"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/emergencyName">
        <Annotation Term="Common.Label" String="Emergency Name"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/emergencyPhone">
        <Annotation Term="Common.Label" String="Emergency Contact"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/isActive">
        <Annotation Term="Common.Label" String="Status"/>
        <Annotation Term="Common.Text" Path="statusMaster/text">
          <Annotation Term="UI.TextArrangement" EnumMember="UI.TextArrangementType/TextOnly"/>
        </Annotation>
      </Annotations>
      <Annotations Target="PatientService.Patients/statusCriticality">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/IsActiveEntity">
        <Annotation Term="UI.Hidden" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/HasActiveEntity">
        <Annotation Term="UI.Hidden" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/HasDraftEntity">
        <Annotation Term="UI.Hidden" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/DraftAdministrativeData">
        <Annotation Term="UI.Hidden" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.Patients/DraftMessages">
        <Annotation Term="Core.Computed" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData">
        <Annotation Term="Common.Label" String="{i18n>Draft_DraftAdministrativeData}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/DraftUUID">
        <Annotation Term="UI.Hidden" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>Draft_DraftUUID}"/>
        <Annotation Term="Core.ComputedDefaultValue" Bool="true"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/CreationDateTime">
        <Annotation Term="Common.Label" String="{i18n>Draft_CreationDateTime}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/CreatedByUser">
        <Annotation Term="Common.Label" String="{i18n>Draft_CreatedByUser}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/DraftIsCreatedByMe">
        <Annotation Term="UI.Hidden" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>Draft_DraftIsCreatedByMe}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/LastChangeDateTime">
        <Annotation Term="Common.Label" String="{i18n>Draft_LastChangeDateTime}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/LastChangedByUser">
        <Annotation Term="Common.Label" String="{i18n>Draft_LastChangedByUser}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/InProcessByUser">
        <Annotation Term="Common.Label" String="{i18n>Draft_InProcessByUser}"/>
      </Annotations>
      <Annotations Target="PatientService.DraftAdministrativeData/DraftIsProcessedByMe">
        <Annotation Term="UI.Hidden" Bool="true"/>
        <Annotation Term="Common.Label" String="{i18n>Draft_DraftIsProcessedByMe}"/>
      </Annotations>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
