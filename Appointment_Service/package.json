{
  "name": "Appointment_Service",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.8.0",
    "@sap-cloud-sdk/http-client": "^4.8.0",
    "@sap-cloud-sdk/resilience": "^4.8.0",
    "@sap/cds": "^10.0.5",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4.0",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "destinations": true,
      "PatientService": {
        "kind": "odata",
        "model": "srv/external/PatientService",
        "credentials": {
          "destination": "PatientService"
        }
      },
      "DoctorService": {
        "kind": "odata",
        "credentials": {
          "destination": "DoctorService"
        }
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  }
}
